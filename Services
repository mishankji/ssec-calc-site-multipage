<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Services — SS Envirocare</title>
<meta name="description" content="EPR compliance, corporate bulk disposal, IT asset disposal, data destruction, buyback and awareness programs from SS Envirocare.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Expanded:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1B1E1C; --paper:#EEEFE9; --paper-dim:#E3E4DC; --panel:#F6F6F1;
    --copper:#B8703E; --copper-lt:#D68A56; --copper-dim:#8F5730;
    --steel:#3E5C6B; --recovered:#4C6E52; --line: rgba(27,30,28,0.14);
    --mono:'IBM Plex Mono',monospace; --display:'Archivo Expanded',sans-serif; --body:'Inter',sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{background:var(--paper);color:var(--ink);font-family:var(--body);line-height:1.55;-webkit-font-smoothing:antialiased;}
  a{color:inherit;text-decoration:none;}
  .wrap{max-width:1180px;margin:0 auto;padding:0 32px;}
  .eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--copper-dim);display:flex;align-items:center;gap:10px;}
  .eyebrow::before{content:"";width:18px;height:1px;background:var(--copper-dim);}
  h1,h2,h3{font-family:var(--display);letter-spacing:-0.01em;}

  header{position:sticky;top:0;z-index:50;background:rgba(238,239,233,0.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);}
  .nav{display:flex;align-items:center;justify-content:space-between;padding:18px 32px;max-width:1180px;margin:0 auto;}
  .logo{font-family:var(--display);font-weight:800;font-size:19px;letter-spacing:-0.02em;display:flex;align-items:baseline;gap:6px;}
  .logo span{color:var(--copper);}
  .navlinks{display:flex;gap:30px;font-size:14px;font-weight:500;}
  .navlinks a:hover{color:var(--copper-dim);}
  .navlinks a.active{color:var(--copper-dim);}
  .navcta{font-family:var(--mono);font-size:12px;letter-spacing:.06em;background:var(--copper);color:var(--ink);padding:11px 18px;border-radius:2px;text-transform:uppercase;font-weight:600;}
  .navcta:hover{background:var(--copper-lt);}
  @media (max-width:860px){.navlinks{display:none;}}

  .pagehero{padding:64px 0 40px;}
  .pagehero h1{font-size:clamp(32px,4.6vw,50px);font-weight:800;max-width:18ch;}
  .pagehero p{font-size:16.5px;max-width:64ch;color:#454842;margin-top:16px;}

  section{padding:0 0 70px;}
  .section-head{max-width:640px;margin-bottom:36px;}
  .section-head h2{font-size:clamp(22px,2.6vw,30px);margin-top:10px;font-weight:700;}

  .svc-list{display:flex;flex-direction:column;border-top:1px solid var(--line);}
  .svc-row{display:grid;grid-template-columns:60px 1fr 180px;gap:28px;align-items:start;padding:36px 0;border-bottom:1px solid var(--line);}
  .svc-row .idx{font-family:var(--mono);font-size:13px;color:var(--copper-dim);padding-top:4px;}
  .svc-row h3{font-size:21px;font-weight:700;}
  .svc-row .tag{font-family:var(--mono);font-size:11px;color:var(--steel);letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px;display:block;}
  .svc-row p{font-size:14.5px;color:#54574f;margin-top:8px;max-width:62ch;}
  .svc-row .req-btn{align-self:center;justify-self:end;border:1px solid var(--ink);padding:11px 18px;font-size:13px;font-weight:600;border-radius:2px;white-space:nowrap;background:none;cursor:pointer;font-family:var(--body);}
  .svc-row .req-btn:hover{border-color:var(--copper-dim);color:var(--copper-dim);}
  @media (max-width:760px){.svc-row{grid-template-columns:1fr;gap:10px;}.svc-row .req-btn{justify-self:start;}}

  /* order request form */
  #order{background:var(--panel);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:70px 0;}
  .order-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:30px;}
  @media (max-width:700px){.order-grid{grid-template-columns:1fr;}}
  .order-grid .full{grid-column:1/-1;}
  .field label{display:block;font-family:var(--mono);font-size:11.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--ink);margin-bottom:8px;}
  .field select, .field input, .field textarea{
    width:100%;background:var(--paper);border:1px solid var(--line);border-radius:2px;
    padding:12px 14px;font-family:var(--body);font-size:14.5px;color:var(--ink);
  }
  .field select:focus, .field input:focus, .field textarea:focus{outline:none;border-color:var(--copper);}
  .field textarea{resize:vertical;min-height:90px;}
  .order-actions{display:flex;gap:12px;margin-top:24px;flex-wrap:wrap;}
  .btn-primary{background:var(--ink);color:var(--paper);padding:14px 24px;font-size:14px;font-weight:600;border-radius:2px;display:inline-block;border:none;cursor:pointer;font-family:var(--body);}
  .btn-primary:hover{background:var(--copper-dim);}
  .btn-secondary{border:1px solid var(--ink);padding:14px 24px;font-size:14px;font-weight:600;border-radius:2px;display:inline-block;}
  .btn-secondary:hover{border-color:var(--copper-dim);color:var(--copper-dim);}
  .order-note{font-size:12px;color:#7c7f77;margin-top:16px;}

  footer{background:var(--ink);color:#C7C9C1;padding:60px 0 30px;font-size:14px;}
  .foot-grid{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:30px;}
  .foot-grid h4{font-family:var(--mono);font-size:12px;color:#8a8d84;text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px;}
  .foot-grid a{display:block;color:#C7C9C1;margin-bottom:9px;font-size:13.5px;}
  .foot-grid a:hover{color:var(--copper-lt);}
  .foot-bottom{margin-top:46px;padding-top:22px;border-top:1px solid rgba(255,255,255,0.12);display:flex;justify-content:space-between;font-size:12.5px;color:#8a8d84;flex-wrap:wrap;gap:10px;}
  @media (max-width:900px){.foot-grid{grid-template-columns:repeat(2,1fr);}}
</style>
</head>
<body>

<header>
  <div class="nav">
    <a href="index.html" class="logo">SS<span>·</span>ENVIROCARE</a>
    <nav class="navlinks">
      <a href="index.html">Home</a>
      <a href="services.html" class="active">Services</a>
      <a href="about.html">About</a>
      <a href="contact.html">Contact</a>
    </nav>
    <a href="index.html#calculator" class="navcta">Value Calculator</a>
  </div>
</header>

<main>
  <section class="pagehero">
    <div class="wrap">
      <div class="eyebrow">Services</div>
      <h1>Full-scale e-waste services, built for business.</h1>
      <p>Beyond individual pickups — documented, compliant, and scoped for companies managing electronics at volume.</p>
    </div>
  </section>

  <section id="services-list">
    <div class="wrap">
      <div class="svc-list">
        <div class="svc-row">
          <div class="idx">01</div>
          <div><span class="tag">EPR</span><h3>EPR Compliance</h3><p>Documentation and reporting that satisfies your Extended Producer Responsibility obligations under CPCB rules — collection targets, filing support, and audit-ready records.</p></div>
          <button class="req-btn" onclick="selectService('EPR Compliance')">Request this →</button>
        </div>
        <div class="svc-row">
          <div class="idx">02</div>
          <div><span class="tag">Corporate</span><h3>Bulk Corporate Disposal</h3><p>Scheduled multi-site lifting with fixed SLAs and a dedicated account manager for organisations retiring electronics at scale.</p></div>
          <button class="req-btn" onclick="selectService('Bulk Corporate Disposal')">Request this →</button>
        </div>
        <div class="svc-row">
          <div class="idx">03</div>
          <div><span class="tag">IT Assets</span><h3>IT Asset Disposal</h3><p>Secure decommissioning of laptops, servers, networking hardware and peripherals — inventoried, wiped, and logged per device.</p></div>
          <button class="req-btn" onclick="selectService('IT Asset Disposal')">Request this →</button>
        </div>
        <div class="svc-row">
          <div class="idx">04</div>
          <div><span class="tag">Security</span><h3>Data Destruction</h3><p>Certified wiping and physical destruction of storage media, with a Certificate of Data Destruction on completion.</p></div>
          <button class="req-btn" onclick="selectService('Data Destruction')">Request this →</button>
        </div>
        <div class="svc-row">
          <div class="idx">05</div>
          <div><span class="tag">Value</span><h3>Buyback Programs</h3><p>Fair valuation on functional or refurbishable equipment — wiped and inspected before any offer is made.</p></div>
          <button class="req-btn" onclick="selectService('Buyback Program')">Request this →</button>
        </div>
        <div class="svc-row">
          <div class="idx">06</div>
          <div><span class="tag">Outreach</span><h3>Awareness Programs</h3><p>Customised workshops and sessions for corporates, institutions and communities on responsible e-waste management.</p></div>
          <button class="req-btn" onclick="selectService('Awareness Program')">Request this →</button>
        </div>
      </div>
    </div>
  </section>

  <section id="order">
    <div class="wrap">
      <div class="eyebrow">Request a service</div>
      <h2 style="font-size:clamp(24px,3.2vw,34px);margin-top:12px;">Tell us what you need — we'll follow up within 24 hours.</h2>

      <div class="order-grid">
        <div class="field"><label for="oService">Service</label>
          <select id="oService">
            <option>EPR Compliance</option>
            <option>Bulk Corporate Disposal</option>
            <option>IT Asset Disposal</option>
            <option>Data Destruction</option>
            <option>Buyback Program</option>
            <option>Awareness Program</option>
          </select>
        </div>
        <div class="field"><label for="oCompany">Company / organisation name</label><input type="text" id="oCompany" placeholder="Optional for individuals"></div>
        <div class="field"><label for="oName">Contact name</label><input type="text" id="oName" placeholder="Your name"></div>
        <div class="field"><label for="oPhone">Phone number</label><input type="tel" id="oPhone" placeholder="10-digit mobile number"></div>
        <div class="field full"><label for="oVolume">Approximate volume / scale</label><input type="text" id="oVolume" placeholder="e.g. 500 laptops, 3 office locations, 12,000 units/year"></div>
        <div class="field full"><label for="oMsg">Additional details</label><textarea id="oMsg" placeholder="Timeline, certifications needed, site locations, anything else we should know"></textarea></div>
      </div>

      <div class="order-actions">
        <button class="btn-primary" id="sendOrderWa">Send Request on WhatsApp →</button>
        <a class="btn-secondary" href="mailto:info@ssenvirocare.in">Email us instead</a>
      </div>
      <p class="order-note">We'll confirm receipt and follow up with next steps, typically within one business day.</p>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="logo" style="color:var(--paper);margin-bottom:14px;">SS<span>·</span>ENVIROCARE</div>
        <p style="color:#8a8d84;font-size:13.5px;max-width:32ch;">Certified e-waste collection and materials recovery, based in Jaipur, Rajasthan.</p>
      </div>
      <div>
        <h4>Site</h4>
        <a href="index.html">Home</a>
        <a href="services.html">Services</a>
        <a href="about.html">About Us</a>
        <a href="contact.html">Contact</a>
      </div>
      <div>
        <h4>Services</h4>
        <a href="#order">EPR Compliance</a>
        <a href="#order">Corporate Bulk Disposal</a>
        <a href="#order">IT Asset Disposal</a>
      </div>
      <div>
        <h4>Contact</h4>
        <a href="tel:+919654463036">+91 96544 63036</a>
        <a href="mailto:info@ssenvirocare.in">info@ssenvirocare.in</a>
        <a href="#">E216 (B), RIA Sarna Dungar, Jaipur</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 SS Envirocare Private Limited. All rights reserved.</span>
      <span>CPCB &amp; SPCB Authorised E-Waste Recycler</span>
    </div>
  </div>
</footer>

<script>
function selectService(name){
  document.getElementById('oService').value = name;
  document.getElementById('order').scrollIntoView({ behavior:'smooth', block:'start' });
}
document.getElementById('sendOrderWa').addEventListener('click', () => {
  const service = document.getElementById('oService').value;
  const company = document.getElementById('oCompany').value;
  const name = document.getElementById('oName').value;
  const phone = document.getElementById('oPhone').value;
  const volume = document.getElementById('oVolume').value;
  const msg = document.getElementById('oMsg').value;
  const text = encodeURIComponent(
    `Hi SS Envirocare, I'd like to request a service.\n` +
    `Service: ${service}\n` +
    (company ? `Company: ${company}\n` : '') +
    `Name: ${name}\nPhone: ${phone}\n` +
    (volume ? `Volume/scale: ${volume}\n` : '') +
    (msg ? `Details: ${msg}` : '')
  );
  window.open(`https://wa.me/919654463036?text=${text}`, '_blank');
});
</script>

</body>
</html>
